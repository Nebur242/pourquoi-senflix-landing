# Base URL of the Senflix API including /api/v1 (no trailing slash), used by the "créateurs
# fondateurs" contact modal to POST interest leads to
#   ${NEXT_PUBLIC_API_BASE_URL}/campaigns/100-founder-creators/interest-leads
# Inlined at build time (NEXT_PUBLIC_*), so set it in Vercel per environment.
# When unset, the modal shows an "indisponible" notice instead of submitting.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX), inlined at build time. The public
# production ID is committed in .env.production (production builds only; Vercel preview builds
# are skipped). Leave empty locally so `next dev` sends nothing.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
